{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["no-must-findings", "must-findings"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "rule",
          "file",
          "line",
          "evidence",
          "scenario",
          "fix",
          "needs_approval",
          "confidence"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["MUST", "SHOULD"]
          },
          "rule": {
            "type": "string",
            "enum": [
              "R1",
              "R2",
              "R3",
              "R4",
              "R5",
              "R6",
              "R7",
              "R8",
              "R9",
              "R10",
              "R11",
              "R12",
              "R13",
              "R14",
              "R15",
              "R16",
              "R17",
              "R18",
              "R19",
              "R20",
              "R21",
              "R22",
              "R23",
              "R24",
              "R25",
              "R26",
              "R27",
              "R28",
              "correctness",
              "requirement"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "evidence": {
            "type": "string"
          },
          "scenario": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "needs_approval": {
            "type": "boolean"
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        }
      }
    }
  }
}

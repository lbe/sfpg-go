#!/usr/bin/env bash
# Strip Cursor agent attribution trailers injected despite user opt-out.
# Runs on every commit (including agent commits that use git hooks).
#
# Portable: no sed -i (GNU vs BSD differ). Filter via temp file + awk.

set -euo pipefail

msgfile="${1:?commit-msg hook requires path to commit message file}"

if [[ ! -f "$msgfile" ]]; then
  echo "[commit-msg] missing commit message file: $msgfile" >&2
  exit 1
fi

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

# Remove known Cursor attribution lines (exact and common variants).
sed \
  -e '/^Co-authored-by: Cursor <cursoragent@cursor.com>[[:space:]]*$/d' \
  -e '/^Made-with: Cursor[[:space:]]*$/d' \
  "$msgfile" > "$tmp"

# Collapse trailing blank lines left after removal (portable awk).
awk '
  { lines[NR] = $0 }
  END {
    n = NR
    while (n > 0 && lines[n] ~ /^[[:space:]]*$/) n--
    for (i = 1; i <= n; i++) print lines[i]
  }
' "$tmp" > "$msgfile"

exit 0

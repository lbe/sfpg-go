#!/usr/bin/env bash
set -euo pipefail

# Pre-commit hook (same checks as scripts/pre-commit-check.sh, minus test-browser):
# 1. make format-check
# 2. make lint
# 3. make validate-templates (includes Hyperscript -quiet)
# 4. make validate-html-test-assertions
# 5. make test-all

echo "[pre-commit] checking code formatting..."
if ! make format-check; then
  echo "[pre-commit] ❌ Formatting check failed. Run 'make format' to fix. Commit aborted."
  exit 1
fi

echo "[pre-commit] running linter..."
if ! make lint; then
  echo "[pre-commit] ❌ Lint failed. Commit aborted."
  exit 1
fi

echo "[pre-commit] validating templates..."
if ! make validate-templates; then
  echo "[pre-commit] ❌ Template validation failed. Commit aborted."
  exit 1
fi

echo "[pre-commit] validating html test assertions..."
if ! make validate-html-test-assertions; then
  echo "[pre-commit] ❌ HTML test assertion validation failed. Commit aborted."
  exit 1
fi

echo "[pre-commit] running tests..."
if ! make test-all; then
  echo "[pre-commit] ❌ Tests failed. Commit aborted."
  exit 1
fi

echo "[pre-commit] ✓ All checks passed"

exit 0

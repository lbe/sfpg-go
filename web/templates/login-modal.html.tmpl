<!-- Login Modal (DaisyUI) -->
<input
  type="checkbox"
  id="login_modal"
  class="modal-toggle"
  _="on change
            if me.checked
              -- Close lightbox when login modal opens
              if #lightbox_modal does not match .hidden
                trigger closeModal on #lightbox_modal
                wait 200ms
              end
              -- Signal HTMX to load login form with fresh CSRF token from uncached endpoint
              send loginModalOpened to body
            end"
/>
<div class="modal" role="dialog">
  <div class="modal-box">
    <h3 class="mb-4 text-lg font-bold">Login</h3>
    <div
      id="login-form-container"
      hx-get="/login-form"
      hx-trigger="loginModalOpened from:body"
      hx-swap="innerHTML"
    >
      <div class="flex items-center justify-center py-8">
        <span class="loading loading-spinner loading-md"></span>
      </div>
    </div>
  </div>
  <label class="modal-backdrop" for="login_modal">Close</label>
</div>

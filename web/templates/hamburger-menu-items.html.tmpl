<li>
  <a
    href="/theme/modal"
    hx-get="/theme/modal"
    hx-target="body"
    hx-swap="beforeend"
    aria-label="Theme"
    >Theme</a
  >
</li>
<li>
  <a
    href="/about-modal"
    hx-get="/about-modal"
    hx-target="body"
    hx-swap="beforeend"
    aria-label="About"
    >About</a
  >
</li>
<div class="divider my-1"></div>
{{ if .IsAuthenticated }}
  <li>
    <a href="/dashboard?v={{ cacheVersion }}" aria-label="Dashboard"
      >Dashboard</a
    >
  </li>
  <li>
    <a
      href="/config?v={{ cacheVersion }}"
      hx-get="/config"
      hx-target="body"
      hx-swap="beforeend"
      aria-label="Configuration"
      >Configuration</a
    >
  </li>
  {{/* Server submenu using DaisyUI collapse */}}
  <li>
    <details class="collapse collapse-arrow bg-base-100">
      <summary class="collapse-title min-h-0 py-2 text-sm font-medium">
        Server
      </summary>
      <div class="collapse-content">
        <ul class="menu-compact menu">
          <li>
            <label
              for="shutdown_modal"
              class="cursor-pointer text-error"
              aria-label="Shutdown"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"
                />
              </svg>
              Shutdown
            </label>
          </li>
          <li>
            <button
              hx-post="/server/discovery"
              hx-target="#server-toast-container"
              hx-swap="innerHTML"
              class="text-success"
              aria-label="Run Discovery"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                />
              </svg>
              Run Discovery
            </button>
          </li>
          <li>
            <button
              hx-post="/server/cache-batch-load"
              hx-target="#server-toast-container"
              hx-swap="innerHTML"
              class="text-success"
              aria-label="Run Cache Batch Load"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.356 2H15"
                />
              </svg>
              Run Cache Batch Load
            </button>
          </li>
        </ul>
      </div>
    </details>
  </li>
  <div class="divider my-1"></div>
  <li>
    <label for="logout_modal" class="cursor-pointer" aria-label="Logout"
      >Logout</label
    >
  </li>
{{ else }}
  <li>
    <label for="login_modal" class="cursor-pointer" aria-label="Login"
      >Login</label
    >
  </li>
{{ end }}

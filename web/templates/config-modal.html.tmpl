<!-- Configuration Modal - Loaded on demand via HTMX -->
<div
  id="config-modal-container"
  _="init
  set #config_modal.checked to true
  call snapshotConfigOriginals()
"
>
  {{ template "config-spinner.html.tmpl" . }}
  <input type="checkbox" id="config_modal" class="modal-toggle" />
  <div class="modal" role="dialog">
    <div
      class="modal-box flex h-[90vh] w-11/12 max-w-5xl flex-col overflow-hidden p-0"
    >
      <!-- Fixed Header -->
      <div
        class="flex flex-shrink-0 items-center justify-between border-b border-base-300 p-6 pb-4"
      >
        <h3 class="text-2xl font-bold">Configuration</h3>
        <label
          for="config_modal"
          class="btn btn-circle btn-ghost btn-sm"
          _="install CloseConfigModal"
          >✕</label
        >
      </div>

      <!-- Alert area for messages (OOB updates) -->
      <div id="config-alerts" class="flex-shrink-0 px-6 pt-2"></div>
      <div id="restart-warning" class="hidden flex-shrink-0 px-6 pt-2"></div>
      <div id="config-success-message" class="flex-shrink-0 px-6 pt-2"></div>

      <!-- Form wraps everything -->
      <form
        id="config-form"
        hx-post="/config"
        hx-target="#config-success-message"
        hx-swap="outerHTML"
        hx-indicator="#config-loading"
        class="flex min-h-0 flex-1 flex-col overflow-hidden"
        _="on load call clearConfigSpinner() on htmx:afterSwap from me call clearConfigSpinner() on htmx:afterSettle from me call clearConfigSpinner()"
      >
        <div
          id="config-error-message"
          class="mb-4 px-6 text-error"
          _="on load call clearConfigSpinner()"
        ></div>

        <!-- Fixed Tabs Navigation -->
        <div role="tablist" class="tabs-boxed tabs mx-6 mb-4 flex-shrink-0">
          <button
            id="tab-server-btn"
            type="button"
            role="tab"
            class="tab tab-active"
            data-tab="tab-server"
            aria-controls="tab-server"
            aria-selected="true"
            _="install TabSwitcher"
          >
            Server
          </button>
          <button
            id="tab-logging-btn"
            type="button"
            role="tab"
            class="tab"
            data-tab="tab-logging"
            aria-controls="tab-logging"
            aria-selected="false"
            _="install TabSwitcher"
          >
            Logging
          </button>
          <button
            id="tab-application-btn"
            type="button"
            role="tab"
            class="tab"
            data-tab="tab-application"
            aria-controls="tab-application"
            aria-selected="false"
            _="install TabSwitcher"
          >
            Application
          </button>
          <button
            id="tab-session-btn"
            type="button"
            role="tab"
            class="tab"
            data-tab="tab-session"
            aria-controls="tab-session"
            aria-selected="false"
            _="install TabSwitcher"
          >
            Session
          </button>
          <button
            id="tab-performance-btn"
            type="button"
            role="tab"
            class="tab"
            data-tab="tab-performance"
            aria-controls="tab-performance"
            aria-selected="false"
            _="install TabSwitcher"
          >
            Performance
          </button>
          <button
            id="tab-discovery-btn"
            type="button"
            role="tab"
            class="tab"
            data-tab="tab-discovery"
            aria-controls="tab-discovery"
            aria-selected="false"
            _="install TabSwitcher"
          >
            Discovery
          </button>
          <button
            id="tab-admin-btn"
            type="button"
            role="tab"
            class="tab"
            data-tab="tab-admin"
            aria-controls="tab-admin"
            aria-selected="false"
            _="install TabSwitcher"
          >
            Admin ID
          </button>
        </div>

        <!-- Scrollable Tab Content -->
        <div id="tab-panels" class="min-h-0 flex-1 overflow-y-auto px-6 pb-6">
          <div
            id="tab-server"
            role="tabpanel"
            aria-labelledby="tab-server-btn"
            class="tab-panel rounded-box border border-base-300 bg-base-100 p-6"
          >
            {{ template "config-server-tab" . }}
          </div>
          <div
            id="tab-logging"
            role="tabpanel"
            aria-labelledby="tab-logging-btn"
            class="tab-panel hidden rounded-box border border-base-300 bg-base-100 p-6"
          >
            {{ template "config-logging-tab" . }}
          </div>
          <div
            id="tab-application"
            role="tabpanel"
            aria-labelledby="tab-application-btn"
            class="tab-panel hidden rounded-box border border-base-300 bg-base-100 p-6"
          >
            {{ template "config-application-tab" . }}
          </div>
          <div
            id="tab-session"
            role="tabpanel"
            aria-labelledby="tab-session-btn"
            class="tab-panel hidden rounded-box border border-base-300 bg-base-100 p-6"
          >
            {{ template "config-session-tab" . }}
          </div>
          <div
            id="tab-performance"
            role="tabpanel"
            aria-labelledby="tab-performance-btn"
            class="tab-panel hidden rounded-box border border-base-300 bg-base-100 p-6"
          >
            {{ template "config-performance-tab" . }}
          </div>
          <div
            id="tab-discovery"
            role="tabpanel"
            aria-labelledby="tab-discovery-btn"
            class="tab-panel hidden rounded-box border border-base-300 bg-base-100 p-6"
          >
            {{ template "config-discovery-tab" . }}
          </div>
          <div
            id="tab-admin"
            role="tabpanel"
            aria-labelledby="tab-admin-btn"
            class="tab-panel hidden rounded-box border border-base-300 bg-base-100 p-6"
          >
            {{ template "config-admin-tab" . }}
          </div>
        </div>

        <!-- Fixed Footer with buttons and info area -->
        <div class="flex-shrink-0 border-t border-base-300 p-6 pt-4">
          <!-- Button explanation and badge area (fixed height) -->
          <div class="mb-2 flex h-8 items-center justify-end">
            <div class="flex items-center gap-2">
              <div
                id="button-explanation-text"
                class="w-[452px] overflow-hidden text-ellipsis whitespace-nowrap text-center text-sm text-base-content/70"
              ></div>
              <div
                id="button-explanation-area-right"
                class="flex items-center justify-center"
              >
                <span
                  id="config-restart-badge"
                  class="badge badge-warning hidden"
                  >Restart Required</span
                >
              </div>
            </div>
          </div>

          <!-- Footer with buttons (right-aligned) -->
          <div class="modal-action justify-end">
            <div class="flex items-center gap-2">
              <button
                type="button"
                class="btn btn-outline btn-sm"
                hx-post="/config/restore-last-known-good?action=preview"
                hx-target="#restore-diff-modal"
                hx-swap="innerHTML"
                data-tip="Restore the last known good configuration from the database"
                _="install ButtonExplanation"
              >
                Restore
              </button>
              <button
                type="button"
                class="btn btn-outline btn-primary btn-sm"
                hx-post="/config/export/to-file"
                hx-target="#export-diff-modal"
                hx-swap="innerHTML"
                data-tip="Export current configuration to a YAML file for backup"
                _="install ButtonExplanation"
              >
                Export
              </button>
              <button
                type="button"
                class="btn btn-outline btn-primary btn-sm"
                _="on click click() on #import-file-input on mouseenter set #button-explanation-text.textContent to 'Import configuration from a YAML file' on mouseleave set #button-explanation-text.textContent to ''"
              >
                Import
              </button>
              <input
                type="file"
                id="import-file-input"
                accept=".yaml,.yml"
                class="hidden"
                hx-post="/config/import/preview"
                hx-target="#import-diff-modal"
                hx-swap="innerHTML"
                hx-trigger="change"
                hx-encoding="multipart/form-data"
                name="yaml"
                _="on change
                if my.files.length > 0
                  set #import-diff-modal-toggle.checked to true
                end"
              />
              <button
                type="button"
                class="btn btn-sm"
                id="config-cancel-btn"
                _="install ConfigCancelButton"
              >
                Cancel
              </button>
              <button
                type="submit"
                class="btn btn-primary btn-sm relative text-center"
                id="config-loading"
              >
                <span class="text-center">Save Settings</span>
                <span
                  id="config-spinner"
                  class="htmx-indicator loading loading-spinner loading-sm absolute inset-0 flex items-center justify-center"
                ></span>
              </button>
            </div>
          </div>
        </div>
      </form>
    </div>

    <!-- Modals for diff display -->
    <input
      type="checkbox"
      id="restore-diff-modal-toggle"
      class="modal-toggle"
    />
    <div id="restore-diff-modal" class="modal" role="dialog"></div>
    <input type="checkbox" id="export-diff-modal-toggle" class="modal-toggle" />
    <div id="export-diff-modal" class="modal" role="dialog"></div>
    <input type="checkbox" id="import-diff-modal-toggle" class="modal-toggle" />
    <div id="import-diff-modal" class="modal" role="dialog"></div>
    <input type="checkbox" id="cancel-diff-modal" class="modal-toggle" />
    <div class="modal" role="dialog">
      <div class="modal-box max-w-4xl">
        <h3 class="mb-4 text-lg font-bold">Unsaved Changes</h3>
        <p class="mb-4">
          You have unsaved changes. Are you sure you want to cancel?
        </p>
        <div
          id="cancel-diff-content"
          class="mb-4 max-h-96 overflow-y-auto rounded border border-base-300 p-4"
        >
          <!-- Diff content will be inserted here -->
        </div>
        <div class="modal-action">
          <label
            for="cancel-diff-modal"
            class="btn btn-primary"
            _="install CloseConfigModal"
            >Discard Changes</label
          >
          <label for="cancel-diff-modal" class="btn">Keep Editing</label>
        </div>
      </div>
      <label class="modal-backdrop" for="cancel-diff-modal"></label>
    </div>
    <input type="checkbox" id="restart-diff-modal" class="modal-toggle" />
    <div class="modal" role="dialog">
      <div class="modal-box max-w-4xl">
        <h3 class="mb-4 text-lg font-bold">Restart Required</h3>
        <p class="mb-4">
          Some settings require a server restart to take effect. The following
          changes will be applied after restart:
        </p>
        <div
          id="restart-diff-content"
          class="mb-4 max-h-96 overflow-y-auto rounded border border-base-300 p-4"
        >
          <!-- Diff content will be inserted here -->
        </div>
        <div class="modal-action">
          <button
            class="btn btn-primary"
            hx-post="/config/restart"
            hx-target="#config-success-message"
            hx-swap="outerHTML"
            _="on htmx:afterRequest
                 -- Close the restart dialog
                 set #restart-diff-modal.checked to false
                 -- Close the config modal
                 set #config_modal.checked to false
                 -- Remove the config modal container after a brief delay
                 wait 100ms
                 remove #config-modal-container from body
                 -- Show the restart overlay
                 send showRestartOverlay to #restart-overlay"
          >
            Restart Server
          </button>
          <label for="restart-diff-modal" class="btn">Close</label>
        </div>
      </div>
      <label class="modal-backdrop" for="restart-diff-modal"></label>
    </div>

    <label
      class="modal-backdrop"
      for="config_modal"
      _="install CloseConfigModal"
    ></label>
  </div>
  <script id="config-password-validator" type="text/javascript">
    function checkPasswordValid(password) {
      const regex =
        /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]).{8,}$/;
      return regex.test(password);
    }

    function validateNewPassword() {
      const newPass = document.getElementById("admin_new_password").value;
      const errorMsg = document.getElementById("admin_new_password_error");
      const inputEl = document.getElementById("admin_new_password");
      const confirmPass = document.getElementById(
        "admin_confirm_password",
      ).value;
      const confirmErrorMsg = document.getElementById(
        "admin_confirm_password_error",
      );

      if (newPass === "") {
        errorMsg.classList.add("hidden");
        inputEl.classList.remove("input-error");
      } else if (!checkPasswordValid(newPass)) {
        errorMsg.classList.remove("hidden");
        errorMsg.textContent =
          "Password must contain at least one uppercase, one lowercase, one number, and one special character";
        inputEl.classList.add("input-error");
      } else {
        errorMsg.classList.add("hidden");
        inputEl.classList.remove("input-error");
      }

      // Also validate password match when new password changes
      if (newPass !== "" && confirmPass !== "" && newPass !== confirmPass) {
        confirmErrorMsg.classList.remove("hidden");
        confirmErrorMsg.textContent = "Passwords do not match";
        document
          .getElementById("admin_confirm_password")
          .classList.add("input-error");
      } else if (
        newPass !== "" &&
        confirmPass !== "" &&
        newPass === confirmPass
      ) {
        confirmErrorMsg.classList.add("hidden");
        document
          .getElementById("admin_confirm_password")
          .classList.remove("input-error");
      } else {
        confirmErrorMsg.classList.add("hidden");
        document
          .getElementById("admin_confirm_password")
          .classList.remove("input-error");
      }
    }

    function validateConfirmPassword() {
      const newPass = document.getElementById("admin_new_password").value;
      const confirmPass = document.getElementById(
        "admin_confirm_password",
      ).value;
      const errorMsg = document.getElementById("admin_confirm_password_error");
      const inputEl = document.getElementById("admin_confirm_password");

      if (newPass !== "" && confirmPass !== "" && newPass !== confirmPass) {
        errorMsg.classList.remove("hidden");
        errorMsg.textContent = "Passwords do not match";
        inputEl.classList.add("input-error");
      } else if (
        newPass !== "" &&
        confirmPass !== "" &&
        newPass === confirmPass
      ) {
        errorMsg.classList.add("hidden");
        inputEl.classList.remove("input-error");
      } else {
        errorMsg.classList.add("hidden");
        inputEl.classList.remove("input-error");
      }
    }

    document.addEventListener("DOMContentLoaded", function () {
      const newPasswordInput = document.getElementById("admin_new_password");
      const confirmPasswordInput = document.getElementById(
        "admin_confirm_password",
      );

      if (newPasswordInput) {
        newPasswordInput.addEventListener("input", validateNewPassword);
      }

      if (confirmPasswordInput) {
        confirmPasswordInput.addEventListener("input", validateConfirmPassword);
      }
    });
  </script>
</div>

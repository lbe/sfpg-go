{{ define "body" }}
  <!-- Dashboard Header -->
  <div
    class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <h1 class="text-2xl font-semibold">System Dashboard</h1>
      <p class="mt-1 text-xs text-base-content/60">
        Real-time performance and health metrics
      </p>
    </div>
    <div class="flex items-center gap-3">
      <div class="indicator">
        <span
          class="badge indicator-item badge-success badge-xs animate-ping"
        ></span>
        <span class="badge badge-success badge-xs"></span>
      </div>
      <span class="badge badge-success badge-outline">Live</span>
      <span id="last-updated" class="text-xs text-base-content/50">
        {{ .Metrics.Timestamp.Format "15:04:05" }}
      </span>
    </div>
  </div>

  {{ template "dashboard-discovery" . }}
  {{ template "dashboard-sse-stats" . }}
{{ end }}

{{ define "config-application-tab" }}
  <div class="form-control mb-4">
    <label class="label">
      <span class="label-text font-semibold">Site Name</span>
    </label>
    <input
      type="text"
      name="site_name"
      placeholder="SFPG Gallery"
      class="input input-bordered w-64"
      value="{{ if .Config }}{{ .Config.SiteName }}{{ end }}"
    />
    <label class="label">
      <span class="label-text-alt">Display name for the gallery site</span>
    </label>
  </div>

  <div class="form-control mb-4">
    <label class="label">
      <span class="label-text font-semibold">Image Directory</span>
    </label>
    <input
      type="text"
      name="image_directory"
      data-requires-restart="true"
      placeholder="/path/to/images"
      class="input input-bordered w-96"
      value="{{ if .Config }}{{ .Config.ImageDirectory }}{{ end }}"
    />
    <label class="label">
      <span class="label-text-alt"
        >Directory path containing images. Restart required.</span
      >
    </label>
  </div>


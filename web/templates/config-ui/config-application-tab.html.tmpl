  <div class="form-control mb-4">
    <label class="label">
      <span class="label-text font-semibold">Default Theme</span>
    </label>
    <select
      name="current_theme"
      class="select select-bordered w-48"
      id="default-theme-select"
    >
      {{ if .Config.Themes }}
        {{ range .Config.Themes }}
          <option
            value="{{ . }}"
            {{ if and $.Config (eq $.Config.CurrentTheme .) }}selected{{ end }}
          >
            {{ . }}
          </option>
        {{ end }}
      {{ else }}
        <option
          value="dark"
          {{ if and .Config (eq .Config.CurrentTheme "dark") }}selected{{ end }}
        >
          dark
        </option>
        <option
          value="light"
          {{ if and .Config (eq .Config.CurrentTheme "light") }}
            selected
          {{ end }}
        >
          light
        </option>
      {{ end }}
    </select>
    <label class="label">
      <span class="label-text-alt"
        >Default theme for the UI (must be one of the selected themes
        above)</span
      >
    </label>
    <div id="theme-validation-error" class="mt-1 hidden text-sm text-error">
      Default theme must be one of the selected themes
    </div>
  </div>
{{ end }}

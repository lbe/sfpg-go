{{ define "dashboard-gallery-row" }}
  <!-- Gallery Row -->
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    <!-- Gallery Statistics -->
    {{ if .GalleryStats }}
      <div class="card border border-base-300/60 bg-base-200 shadow-none">
        <div class="card-body gap-2 !p-2.5">
          <div class="flex items-center justify-between">
            <h3
              id="card-gallery-stats"
              class="flex items-center gap-2 text-xs font-semibold tracking-wide"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 shrink-0 opacity-70"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                />
              </svg>
              Gallery Statistics
            </h3>
            <!-- prettier-ignore -->
            <span class="tooltip tooltip-bottom" id="gallery-discovery-tip" data-tip="{{- if and .GalleryStats.FirstDiscovery .GalleryStats.LastDiscovery }}First: {{ .GalleryStats.FirstDiscovery }} · Last: {{ .GalleryStats.LastDiscovery }}{{ else if .GalleryStats.FirstDiscovery }}First: {{ .GalleryStats.FirstDiscovery }}{{ else if .GalleryStats.LastDiscovery }}Last: {{ .GalleryStats.LastDiscovery }}{{ else }}Discovery: unknown{{ end -}}">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="h-3.5 w-3.5 opacity-50 hover:opacity-80"
              >
                <path
                  fill-rule="evenodd"
                  d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z"
                  clip-rule="evenodd"
                />
              </svg>
            </span>
          </div>
          <div
            class="stats stats-vertical w-full bg-transparent lg:stats-horizontal"
          >
            <div class="stat gap-0 !px-2 !py-1">
              <div class="stat-title !text-[11px] opacity-60">Folders</div>
              <div class="stat-value text-sm font-semibold">
                {{ .GalleryStats.Folders }}
              </div>
            </div>
            <div class="stat gap-0 !px-2 !py-1">
              <div class="stat-title !text-[11px] opacity-60">Images</div>
              <div class="stat-value text-sm font-semibold">
                {{ .GalleryStats.Images }}
              </div>
            </div>
            <div class="stat gap-0 !px-2 !py-1">
              <div class="stat-title !text-[11px] opacity-60">Images Size</div>
              <div class="stat-value text-sm font-semibold">
                {{ .GalleryStats.ImagesSize | formatBytesInt64 }}
              </div>
            </div>
          </div>
        </div>
      </div>
    {{ else }}
      <div class="card border border-base-300/60 bg-base-200 shadow-none">
        <div class="card-body gap-2 !p-2.5">
          <h3
            class="flex items-center gap-2 text-xs font-semibold tracking-wide"
          >
            Gallery Statistics
          </h3>
          <div class="text-xs text-base-content/60">
            Loading gallery data...
          </div>
        </div>
      </div>
    {{ end }}


    <!-- File Processing Stats -->
    <div class="card border border-base-300/60 bg-base-200 shadow-none">
      <div class="card-body gap-2 !p-2.5">
        <h3 class="flex items-center gap-2 text-xs font-semibold tracking-wide">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 shrink-0 opacity-70"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"
            />
          </svg>
          File Processing
        </h3>
        <div
          class="stats stats-vertical w-full bg-transparent lg:stats-horizontal"
        >
          <div class="stat gap-0 !px-2 !py-1">
            <div class="stat-title !text-[11px] opacity-60">Total Found</div>
            <div id="fp-total" class="stat-value text-sm font-semibold">
              {{ formatCount .Metrics.FileProcessing.TotalFound }}
            </div>
          </div>
          <div class="stat gap-0 !px-2 !py-1">
            <div class="stat-title !text-[11px] opacity-60">Existing</div>
            <div
              id="fp-existing"
              class="stat-value text-sm font-semibold text-warning"
            >
              {{ formatCount .Metrics.FileProcessing.AlreadyExisting }}
            </div>
          </div>
          <div class="stat gap-0 !px-2 !py-1">
            <div class="stat-title !text-[11px] opacity-60">New</div>
            <div
              id="fp-new"
              class="stat-value text-sm font-semibold text-success"
            >
              {{ formatCount .Metrics.FileProcessing.NewlyInserted }}
            </div>
          </div>
          <div class="stat gap-0 !px-2 !py-1">
            <div class="stat-title !text-[11px] opacity-60">Invalid</div>
            <div
              id="fp-invalid"
              class="stat-value text-sm font-semibold text-error"
            >
              {{ formatCount .Metrics.FileProcessing.SkippedInvalid }}
            </div>
          </div>
          <div class="stat gap-0 !px-2 !py-1">
            <div class="stat-title !text-[11px] opacity-60">In Flight</div>
            <div
              id="fp-inflight"
              class="stat-value text-sm font-semibold text-primary"
            >
              {{ formatCount .Metrics.FileProcessing.InFlight }}
            </div>
          </div>
          <div class="stat gap-0 !px-2 !py-1">
            <div class="stat-title !text-[11px] opacity-60">Queued Items</div>
            <div id="queue-queued" class="stat-value text-sm font-semibold">
              {{ formatCount .Metrics.QueueLength }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{{ end }}

{{ define "dashboard-cache-batch-load" }}
  <!-- Cache Batch Load -->
  <div class="card border border-base-300/60 bg-base-200 shadow-none">
    <div class="card-body gap-2 !p-2.5">
      <div class="flex items-center justify-between">
        <h3
          id="card-cache-batch-load"
          class="flex items-center gap-2 text-xs font-semibold tracking-wide"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 shrink-0 opacity-70"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
            />
          </svg>
          Cache Batch Load
        </h3>
        {{ if .Metrics.CacheBatchLoad.IsRunning }}
          <span
            id="batch-status"
            class="badge badge-success badge-sm animate-pulse"
            >Running</span
          >
        {{ else }}
          <span id="batch-status" class="badge badge-ghost badge-sm">Idle</span>
        {{ end }}
      </div>

      <div
        class="stats stats-vertical w-full bg-transparent lg:stats-horizontal"
      >
        <div class="stat gap-0 !px-2 !py-1">
          <div class="stat-title !text-[11px] opacity-60">Loaded</div>
          <div id="batch-loaded" class="stat-value text-sm font-semibold">
            {{ formatCount .Metrics.CacheBatchLoad.TargetsCompleted }}
          </div>
        </div>
        <div class="stat gap-0 !px-2 !py-1">
          <div class="stat-title !text-[11px] opacity-60">Failed</div>
          <div
            id="batch-failed"
            class="{{ if gt .Metrics.CacheBatchLoad.TargetsFailed 0 }}
              text-error
            {{ end }} stat-value text-sm font-semibold"
          >
            {{ formatCount .Metrics.CacheBatchLoad.TargetsFailed }}
          </div>
        </div>
        <div class="stat gap-0 !px-2 !py-1">
          <div class="stat-title !text-[11px] opacity-60">Skipped</div>
          <div id="batch-skipped" class="stat-value text-sm font-semibold">
            {{ formatCount .Metrics.CacheBatchLoad.TargetsSkipped }}
          </div>
        </div>
        <div class="stat gap-0 !px-2 !py-1">
          <div class="stat-title !text-[11px] opacity-60">Total</div>
          <div id="batch-total-desc" class="stat-value text-sm font-semibold">
            {{ formatCount (cacheBatchLoadExpectedTotal .GalleryStats) }} total
          </div>
        </div>
      </div>

      <div id="batch-progress" class="mt-2 text-sm">
        {{ formatCount (cacheBatchLoadDone .Metrics.CacheBatchLoad) }} /
        {{ formatCount (cacheBatchLoadExpectedTotal .GalleryStats) }}
      </div>

      <progress
        class="progress progress-primary mt-2 w-full"
        value="{{ cacheBatchLoadDonePercent .Metrics.CacheBatchLoad .GalleryStats }}"
        max="100"
      ></progress>
    </div>
  </div>
{{ end }}

{{ define "dashboard-sse-stats" }}
  <!-- Runtime Metrics -->
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    <!-- Memory Stats -->
    <div class="card border border-base-300/60 bg-base-200 shadow-none">
      <div class="card-body gap-2 !p-2.5">
        <h3
          id="card-memory"
          class="flex items-center gap-2 text-xs font-semibold tracking-wide"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 shrink-0 opacity-70"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"
            />
          </svg>
          Memory
        </h3>
        <div
          class="stats stats-vertical w-full bg-transparent lg:stats-horizontal"
        >
          <div class="stat gap-0 !px-2 !py-1">
            <div class="stat-title !text-[11px] opacity-60">Allocated</div>
            <div id="mem-allocated" class="stat-value text-sm font-semibold">
              {{ formatBytes .Metrics.Runtime.MemAlloc }}
            </div>
          </div>
          <div class="stat gap-0 !px-2 !py-1">
            <div class="stat-title !text-[11px] opacity-60">Heap In Use</div>
            <div id="mem-heap-in-use" class="stat-value text-sm font-semibold">
              {{ formatBytes .Metrics.Runtime.MemHeapInuse }}
            </div>
          </div>
          <div class="stat gap-0 !px-2 !py-1">
            <div class="stat-title !text-[11px] opacity-60">Heap Released</div>
            <div
              id="mem-heap-released"
              class="stat-value text-sm font-semibold"
            >
              {{ formatBytes .Metrics.Runtime.MemHeapReleased }}
            </div>
          </div>
          <div class="stat gap-0 !px-2 !py-1">
            <div class="stat-title !text-[11px] opacity-60">Heap Objects</div>
            <div id="mem-heap-objects" class="stat-value text-sm font-semibold">
              {{ formatCount .Metrics.Runtime.MemHeapObjects }}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Goroutines & GC -->
    <div class="card border border-base-300/60 bg-base-200 shadow-none">
      <div class="card-body gap-2 !p-2.5">
        <h3
          id="card-runtime"
          class="flex items-center gap-2 text-xs font-semibold tracking-wide"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 shrink-0 opacity-70"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 10V3L4 14h7v7l9-11h-7z"
            />
          </svg>
          Runtime
        </h3>
        <div
          class="stats stats-vertical w-full bg-transparent lg:stats-horizontal"
        >
          <div class="stat gap-0 !px-2 !py-1">
            <div class="stat-title !text-[11px] opacity-60">Goroutines</div>
            <div
              id="runtime-goroutines"
              class="stat-value text-sm font-semibold"
            >
              {{ formatCount .Metrics.Runtime.NumGoroutine }}
            </div>
          </div>
          <div class="stat gap-0 !px-2 !py-1">
            <div class="stat-title !text-[11px] opacity-60">CPU Count</div>
            <div
              id="runtime-cpu-count"
              class="stat-value text-sm font-semibold"
            >
              {{ formatCount .Metrics.Runtime.NumCPU }}
            </div>
          </div>
          <div class="stat gap-0 !px-2 !py-1">
            <div class="stat-title !text-[11px] opacity-60">Next GC</div>
            <div id="runtime-next-gc" class="stat-value text-sm font-semibold">
              {{ formatBytes .Metrics.Runtime.NextGC }}
            </div>
          </div>
          <div class="stat gap-0 !px-2 !py-1">
            <div class="stat-title !text-[11px] opacity-60">Uptime</div>
            <div id="runtime-uptime" class="stat-value text-sm font-semibold">
              {{ formatDuration .Metrics.Runtime.Uptime }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{{ end }}

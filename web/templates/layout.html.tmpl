{{ define "image-count" }}
  {{- if . -}}
    {{- if .ImageCount -}}
      {{- if gt .ImageCount 0 -}}
        {{- .ImageCount }}
        {{ if eq .ImageCount 1 }}Image{{- else }}Images{{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{ end }}
{{ define "layout" }}
  <!DOCTYPE html>
  <html lang="en" data-theme="{{ .Theme }}">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <meta name="description" content="SFPG-Go-Gemini Image Gallery" />
      <title>SEPG</title>
      <link
        rel="icon"
        href="/static/favicon/favicon.svg"
        type="image/svg+xml"
      />
      <link href="/static/css/styles.css" rel="stylesheet" type="text/css" />
      <script src="/static/js/htmx.min.js"></script>
      <script src="/static/js/hyperscript.min.js"></script>
      {{ template "hyperscript-global.html.tmpl" . }}
      {{ template "hyperscript-restart.html.tmpl" . }}
      {{ template "body-behavior.html.tmpl" . }}
      {{ template "lightbox-behavior.html.tmpl" . }}
      {{ template "dashboard-poller-behavior.html.tmpl" . }}
      {{ template "info-box-behavior.html.tmpl" . }}
      {{ template "actual-size-behavior.html.tmpl" . }}
      {{ template "breadcrumbs-behavior.html.tmpl" . }}
      {{ template "footer-buttons-behavior.html.tmpl" . }}
      {{ template "restart-overlay-behavior.html.tmpl" . }}
      {{ template "config-behavior.html.tmpl" . }}
      <style>
        @media (hover: none) and (pointer: coarse), (any-pointer: coarse) {
          #info-btn-mobile {
            display: flex !important;
          }

          #info-btn {
            display: none !important;
          }

          #box_info_wrapper {
            display: none !important;
          }
        }
      </style>
    </head>
    <body
      class="flex h-screen flex-col overflow-hidden bg-base-100"
      style="padding-bottom: max(0px, env(safe-area-inset-bottom));"
      _="install BodyKeyHandler"
    >
      {{ template "info-box.html.tmpl" . }}


      <div class="flex flex-1 overflow-hidden">
        {{ template "info-box-sidebar.html.tmpl" . }}


        <!-- Main Content Area -->
        <div id="BodyContainer" class="relative flex-1">
          <div id="gallery-content" class="h-full w-full overflow-y-auto">
            {{ if eq .PageName "dashboard" }}
              <div id="dashboard-container" class="space-y-8 p-6">
                {{ template "body" . }}
              </div>
            {{ else }}
              {{ template "body" . }}
            {{ end }}
          </div>

          {{/* Dashboard polling element - outside #dashboard-container to survive swaps */}}
          {{ if eq .PageName "dashboard" }}
            <div
              hx-get="/dashboard"
              hx-trigger="every 5s"
              hx-target="#dashboard-container"
              hx-swap="innerHTML"
              _="install DashboardPoller"
            ></div>
          {{ end }}

          {{ template "lightbox-modals.html.tmpl" . }}
        </div>
      </div>

      {{ template "footer-controls.html.tmpl" . }}


      <!-- Login Modal (at body level for proper z-index) -->
      {{ template "login-modal.html.tmpl" . }}


      <!-- Logout Modal (at body level for proper z-index) -->
      {{ template "logout-modal.html.tmpl" . }}


      <!-- About Modal (at body level for proper z-index) -->
      {{ template "about-modal.html.tmpl" . }}


      <!-- Shutdown Modal (at body level for proper z-index) -->
      {{ template "shutdown-modal.html.tmpl" . }}


      <!-- Server Toast Container (for notifications) -->
      <div id="server-toast-container" class="fixed right-4 top-4 z-[70]"></div>

      {{ template "restart-overlay.html.tmpl" . }}
    </body>
  </html>
{{ end }}
